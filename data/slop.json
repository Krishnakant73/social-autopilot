  "grammar_regex": {
    "ing_opener": {
      "re": "(?:^|\\n)[\\s>*\\-]*[A-Z][a-z]+ing\\b[^.\\n]{0,60},",
      "fix": "Put the actor first."
    },
    "nominalisation": {
      "re": "\\bthe \\w+(?:tion|sion|ment|ance|ence|ization|isation) of\\b",
      "fix": "Use the verb: 'the optimisation of X' -> 'optimising X'."
    },
    "abstract_stack": {
      "re": "\\b(alignment|transformation|optimization|optimisation|innovation|efficiency|scalability|synergy)\\b.{0,40}\\b(alignment|transformation|optimization|optimisation|innovation|efficiency|scalability|synergy)\\b",
      "fix": "Replace one abstraction with the concrete thing."
    }
  },
  "structural_regex": {
    "not-just": {
      "re": "\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.;]\\s*it'?s\\b",
      "severity": "high",
      "fix": "Say the one thing you mean. Delete the setup half."
    },
    "not-only": {
      "re": "\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "severity": "medium",
      "fix": "Pick the stronger half."
    },
    "isnt-about": {
      "re": "\\b(?:this|it) (?:is(?:n'?t| not)|'?s not) about [^.!?\\n]{2,60}[.,;!]\\s*it'?s about\\b",
      "severity": "high",
      "fix": "Lead with Y."
    },
    "question-isnt": {
      "re": "\\bthe (real )?(question|problem|issue|point) (isn'?t|is not) [^.!?\\n]{2,50}[,.;]\\s*(it'?s|it is)\\b",
      "severity": "high",
      "fix": "State the real question directly."
    },
    "this-isnt-this-is": {
      "re": "\\bthis (isn'?t|is not) [^.!?\\n]{1,40}[.,;]\\s*this is\\b",
      "severity": "high",
      "fix": "Say what it is."
    },
    "the-result": {
      "re": "(?:^|\\n)\\s*(?:the (?:result|outcome|answer|lesson|best part|kicker|catch|truth|twist))\\?\\s*(?:$|\\n)",
      "severity": "medium",
      "fix": "Answer it inline."
    },
    "heres-what": {
      "re": "\\bhere'?s what (?:i|we) learned\\b",
      "severity": "medium",
      "fix": "Start with the first lesson."
    },
    "plot-twist": {
      "re": "(?:^|\\n)\\s*(plot twist|spoiler( alert)?|the twist)[:?]",
      "severity": "medium",
      "fix": "Delete the label; keep the fact."
    },
    "stop-start": {
      "re": "(?:^|\\n)\\s*stop \\w+[^.\\n]{0,40}[.,]\\s?start\\b",
      "severity": "medium",
      "fix": "Say the one instruction with a reason."
    },
    "hashtag-wall": {
      "re": "(?:#[\\p{L}\\d_]+[ \\t]*){5,}",
      "severity": "medium",
      "fix": "Max 3 hashtags (LinkedIn), 0-1 (X)."
    },
    "in-summary": {
      "re": "(?:^|\\n)\\s*(?:in summary|to summari[sz]e|in conclusion)\\b",
      "severity": "medium",
      "fix": "End on the last true sentence."
    },
    "outline-closer": {
      "re": "\\bdespite (its|the) [^.\\n]+, faces (challenges|obstacles)\\b|(?:^|\\n)\\s*looking ahead, [^.\\n]+ (will|must|should)\\b",
      "severity": "medium",
      "fix": "Cut the essay closer."
    },
    "staccato": {
      "re": "(?:^|\\n)(\\w+\\. ){2,}\\w+\\.\\s*(?:$|\\n)",
      "severity": "medium",
      "fix": "Join two fragments into one sentence."
    },
    "no-no-just": {
      "re": "\\bno \\w+\\. no \\w+\\. (just|only) \\w+",
      "severity": "medium",
      "fix": "One sentence with the point."
    },
    "all-none": {
      "re": "\\ball (of )?the \\w+\\. none of the \\w+",
      "severity": "medium",
      "fix": "State the claim once."
    },
    "pseudo-socratic": {
      "re": "\\b(why|how|what happened)\\? (because|simple|easy)\\b",
      "severity": "medium",
      "fix": "Answer without the staged question."
    },
    "end-tell": {
      "re": "\\b(that'?s it|that'?s all|that'?s the post|full stop)\\.\\s*$",
      "severity": "low",
      "fix": "End on the last true sentence."
    },
    "caps-shout": {
      "re": "\\b[A-Z]{3,}\\b(?:\\s+\\b[A-Z]{3,}\\b){2,}",
      "severity": "medium",
      "fix": "No all-caps runs.",
      "flags": "gu"
    },
    "emoji-bullets": {
      "re": "(?:^|\\n)\\s*\\p{Extended_Pictographic}[^\\n]*\\n\\s*\\p{Extended_Pictographic}",
      "severity": "medium",
      "fix": "Plain list markers or none.",
      "flags": "gu"
    },
    "thread-label": {
      "re": "^\\s*(a |quick )?thread\\b|^\\s*🧵",
      "severity": "high",
      "fix": "Open with the claim, not the label."
    }
  },
  "script_regex": {
    "meta-phrase": {
      "re": "\\b(?:in (?:this|today'?s) (?:video|reel|post|thread)|today i'?m going to show you|i'?m going to (?:show|teach|walk) you|let'?s dive in|let'?s get into it|but there'?s a twist|watch (till|until) the end|before we get started|don'?t forget to subscribe)\\b",
      "severity": "high",
      "fix": "Start at the claim."
    },
    "greeting-open": {
      "re": "^\\s*(so,?|ok(ay)?,?|hey|hi|hello|yo|what'?s up|welcome( back)?)\\b",
      "severity": "high",
      "fix": "Cut the greeting; first word carries payload."
    },
    "imagine-open": {
      "re": "^\\s*imagine (you|if|a)\\b",
      "severity": "medium",
      "fix": "Show the real case instead."
    },
    "hype-adjective": {
      "re": "\\b(insane|crazy|mind-blowing|unbelievable|epic|incredible|game-?changing)\\b",
      "severity": "medium",
      "fix": "Use the number or the name."
    },
    "rhetorical-qa": {
      "re": "\\?\\s+[A-Z][^.?!]{0,30}\\.\\s+[^?]{0,60}\\?\\s+[A-Z][^.?!]{0,30}\\.",
      "severity": "low",
      "fix": "Fewer staged Q-then-A pairs."
    }
  },
